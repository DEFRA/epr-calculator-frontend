@model EPR.Calculator.Frontend.ViewModels.CsvUpload.CsvUploadViewModel;

@{
    ViewData["Title"] = Model.Title;
}

<vc:user-nav back-link="@Model.BackLinkUrl"/>
<partial name="_UploadFileErrorSummaryPartial" model="Model.ErrorsViewModel"/>
<h1 class="govuk-heading-l">@Model.Title</h1>

@if (Model.HasDownloadableTemplate)
{
    <h2 class="govuk-heading-m">Before you upload your file</h2>

    <div class="govuk-form-group">
        <p class="govuk-body">Make sure you're using the latest version of the
            <a class="govuk-link" href="@Model.Template!.Url">
                @Model.Template.LinkText
            </a>.
        </p>
    </div>
}

@using (Html.BeginForm("Upload", "LocalAuthorityUploadFile", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="govuk-form-group @(Model.HasErrors ? "govuk-form-group--error" : null)">
        @if (Model.HasErrors)
        {
            <label class="govuk-label govuk-label--m" for="@Model.InputId">
                Fix and re-upload the file
            </label>

            <partial name="_UploadFileErrorDetailsPartial" model="@Model.ErrorsViewModel"/>
        }
        else
        {
            <label class="govuk-label govuk-label--m" for="@Model.InputId">
                Upload a file
            </label>

            <partial name="_UploadFileInformationPartial" model="@Model"/>
        }

        <input id="@Model.InputId"
               class="govuk-file-upload"
               name="fileUpload"
               type="file"
               aria-describedby="@Model.InputDescribedBy"
               aria-invalid="@(Model.HasErrors ? "true" : null)">
    </div>

    <button id="btnUploadFile" type="submit" class="govuk-button" data-module="govuk-button">
        Upload file
    </button>
}
