@using EPR.Calculator.Frontend.Extensions
@model LocalAuthorityViewModel

<vc:user-nav back-link="@Url.Action("Index", "Dashboard")"/>

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="govuk-!-margin-bottom-9">
                <div class="govuk-caption-l govuk-!-margin-bottom-1">Financial
                    year @Model.RelativeYear.ToFinancialYear()</div>
                <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">Local authority disposal costs</h1>

                @if (Model.IsDataAvailable)
                {
                    <p class="govuk-body">
                        Last updated by @Model.LastUpdatedBy at @Model.LastUpdatedAt.DisplayAsTimeOnDate()
                    </p>
                }
            </div>

            @if (Model.IsDataAvailable)
            {
                @foreach (var country in Model.ByCountry!)
                {
                    <h2 class="govuk-heading-l govuk-!-margin-top-3">@country.Key</h2>
                    <dl class="govuk-summary-list govuk-!-margin-bottom-9">
                        @foreach (var localAuthorityData in country)
                        {
                            <div class="govuk-summary-list__row">
                                <dt class="govuk-summary-list__key">
                                    @localAuthorityData.Material
                                </dt>
                                <dd class="govuk-summary-list__actions">
                                    @localAuthorityData.TotalCost
                                </dd>
                            </div>
                        }
                    </dl>
                }

                @using (Html.BeginForm("Index", "LocalAuthorityUploadFile", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="govuk-button-group">
                        <a href="@Url.Action("Index", "LocalAuthorityUploadFile")" class="govuk-button" type="submit">
                            Upload new costs
                        </a>
                        <a href="@Url.Action("Index", "Dashboard")" class="govuk-link" type="dash">
                            Back to dashboard
                        </a>
                    </div>
                }
            }
            else
            {
                <partial name="_LapcapDataNotExistsPartial"/>
            }
        </div>
    </div>
</div>
