@using EPR.Calculator.Frontend.Helpers
@model ChangeFinancialYearViewModel
@{
    ViewData["Title"] = "Which financial year do you want to manage?";
    var hasError = ViewData.HasErrorFor(nameof(Model.RelativeYear));
}

<vc:user-nav back-link="@Url.Action(ActionNames.Index, ControllerNames.Dashboard)"/>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <partial name="_ValidationSummaryPartial" />

        @using (Html.BeginForm(ActionNames.Index, ControllerNames.ChangeFinancialYear, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="govuk-form-group @(hasError ? "govuk-form-group--error" : "")">
                <fieldset class="govuk-fieldset" aria-describedby="@(hasError ? "relative-year-error" : null)">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                        <h1 class="govuk-fieldset__heading">Which financial year do you want to manage?</h1>
                    </legend>

                    @if (hasError)
                    {
                        <p id="relative-year-error" class="govuk-error-message">
                            <span class="govuk-visually-hidden">Error:</span> @ErrorMessages.FinancialYearNotSelected
                        </p>
                    }

                    <div class="govuk-radios" data-module="govuk-radios">
                        @for (var i = 0; i < Model.RelativeYears.Count; i++)
                        {
                            var year = Model.RelativeYears[i];
                            var id = i == 0 ? nameof(Model.RelativeYear) : $"{nameof(Model.RelativeYear)}-{year}";

                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="@id" name="@nameof(Model.RelativeYear)" type="radio" value="@year" checked="@(Model.RelativeYear == year.Value)">
                                <label class="govuk-label govuk-radios__label" for="@id">@year.ToFullFinancialYear()</label>
                            </div>
                        }
                    </div>
                </fieldset>
            </div>

            <button type="submit" class="govuk-button" data-module="govuk-button">Set financial year</button>
        }
    </div>
</div>
