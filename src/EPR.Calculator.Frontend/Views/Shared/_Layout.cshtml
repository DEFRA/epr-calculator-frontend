<!DOCTYPE html>
<html lang="en" class="govuk-template">

<head>
    <meta charset="utf-8">
    <title>@(ViewData["Title"] is string pageTitle ? $"{pageTitle} - " : string.Empty)Calculate waste disposal fees</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#00a33b">
    <link rel="icon" sizes="48x48" href="~/assets/images/favicon.ico">
    <link rel="icon" sizes="any" href="~/assets/images/favicon.svg" type="image/svg+xml">
    <link rel="mask-icon" href="~/assets/images/govuk-icon-mask.svg" color="#00a33b">
    <link rel="apple-touch-icon" href="~/assets/images/apple-touch-icon.png">
    <link rel="manifest" href="~/assets/manifest.json">
    <link rel="stylesheet" href="~/css/govuk-frontend-6.6.0.min.css" />
    <link rel="stylesheet" href="~/css/defra-internal.css" />
    <link rel="stylesheet" href="~/css/styles.css" />
</head>

<body class="govuk-template__body defra-internal js-enabled govuk-frontend-supported">
    <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">Skip to main content</a>

    <header class="defra-internal-header">
        <div class="govuk-width-container">
            <div class="defra-internal-header__main">
                <div class="defra-internal-header__logo">
                    <p class="govuk-body defra-internal-header__logo-link">
                        Department for Environment<br>Food &amp; Rural Affairs
                    </p>
                </div>
            </div>
        </div>
    </header>

    <div class="defra-internal-service-header">
        <section aria-label="Service information" class="govuk-service-navigation" data-module="govuk-service-navigation">
            <div class="govuk-width-container">
                <div class="govuk-service-navigation__container">
                    <span class="govuk-service-navigation__service-name">
                        <a href="/" class="govuk-service-navigation__link">
                            Calculate waste disposal fees
                        </a>
                    </span>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="defra-internal-service-navigation__context">
                        <ul class="defra-internal-account-menu">
                            <li><span class="govuk-visually-hidden">Signed in as </span>@(User.FindFirst("name")?.Value ?? User.Identity.Name)</li>
                            <li>
                                <a href="@Url.Action("SignOut", "Account", new { area = "MicrosoftIdentity" })"
                                   class="govuk-link govuk-link--no-visited-state govuk-link--no-underline">Sign out</a>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="govuk-width-container">
        <main class="govuk-main-wrapper govuk-!-padding-top-4" id="main-content" role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="defra-internal-footer">
        <div class="govuk-width-container">
            <div class="govuk-footer__meta">
                <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
                    <div class="govuk-!-margin-bottom-6">
                        <h2 class="govuk-heading-s govuk-!-margin-bottom-2">Get help</h2>
                        <p class="govuk-body-s govuk-!-margin-bottom-1">Email: <a class="govuk-link govuk-link--no-visited-state" href="mailto:eprcustomerservice@defra.gov.uk">eprcustomerservice@defra.gov.uk</a></p>
                        <p class="govuk-body-s govuk-!-margin-bottom-1">Telephone: 0300 060 0002</p>
                        <p class="govuk-body-s govuk-!-margin-bottom-0">Monday to Friday, 8:30am to 4:30pm</p>
                    </div>

                    <h2 class="govuk-visually-hidden">Support links</h2>
                    <ul class="govuk-footer__inline-list">
                        <li class="govuk-footer__inline-list-item">
                            <a class="govuk-link defra-internal-footer__link" href="https://www.gov.uk/help/accessibility-statement">Accessibility statement</a>
                        </li>
                        <li class="govuk-footer__inline-list-item">
                            <a class="govuk-link defra-internal-footer__link" href="https://www.gov.uk/help/cookies">Cookies</a>
                        </li>
                        <li class="govuk-footer__inline-list-item">
                            <a class="govuk-link defra-internal-footer__link" href="https://www.gov.uk/help/privacy-notice">Privacy</a>
                        </li>
                    </ul>

                    <svg aria-hidden="true" focusable="false" class="govuk-footer__licence-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 483.2 195.7" height="17" width="41">
                        <path fill="currentColor" d="M421.5 142.8V.1l-50.7 32.3v161.1h112.4v-50.7zm-122.3-9.6A47.12 47.12 0 0 1 221 97.8c0-26 21.1-47.1 47.1-47.1 16.7 0 31.4 8.7 39.7 21.8l42.7-27.2A97.63 97.63 0 0 0 268.1 0c-36.5 0-68.3 20.1-85.1 49.7A98 98 0 0 0 97.8 0C43.9 0 0 43.9 0 97.8s43.9 97.8 97.8 97.8c36.5 0 68.3-20.1 85.1-49.7a97.76 97.76 0 0 0 149.6 25.4l19.4 22.2h3v-87.8h-80l24.3 27.5zM97.8 145c-26 0-47.1-21.1-47.1-47.1s21.1-47.1 47.1-47.1 47.2 21 47.2 47S123.8 145 97.8 145"></path>
                    </svg>
                    <span class="govuk-footer__licence-description govuk-body-s govuk-!-margin-bottom-0">
                        All content is available under the
                        <a class="govuk-link defra-internal-footer__link" href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" rel="license">Open Government Licence v3.0</a>, except where otherwise stated
                    </span>
                </div>
                <div class="govuk-footer__meta-item">
                    <a class="govuk-link defra-internal-footer__link govuk-footer__copyright-logo govuk-body-s" href="https://www.nationalarchives.gov.uk/information-management/re-using-public-sector-information/uk-government-licensing-framework/crown-copyright/">&copy; Crown copyright</a>
                </div>
            </div>
        </div>
    </footer>

    <script type="module" src="~/js/govuk-init.js"></script>
</body>

</html>
