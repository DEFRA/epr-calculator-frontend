@model CalculatorConfirmationViewModel;

<vc:user-nav show-back-link="false"/>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div class="govuk-panel govuk-panel--confirmation">
            <h1 class="govuk-panel__title">
                Your new calculation is running
            </h1>
            <div class="govuk-panel__body">
               Calculation reference<br>
               <strong>@Model.CalculationName</strong>
            </div>
        </div>

        <table class="govuk-table" aria-describedby="calc-year-table-description">
            <caption id="calc-year-table-description" class="govuk-visually-hidden">
                Calculation run financial year
            </caption>
            <tbody class="govuk-table__body">
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header">Financial year</th>
                    <td class="govuk-table__cell">@Model.RelativeYear.ToFinancialYear()</td>
                </tr>
            </tbody>
        </table>

        <h2 class="govuk-heading-m">What you need to do</h2>
        <p class="govuk-body">
            Your calculation is running. You can leave this page and check its progress from the dashboard.
        </p>

        <h2 class="govuk-heading-m">What happens next</h2>
        <p class="govuk-body">
            When the results are ready, open the calculation from the dashboard. Download and review the results file.
        </p>

        <div class="govuk-button-group govuk-!-margin-top-6">
            <a href="@Url.Action(ActionNames.Index,ControllerNames.Dashboard)" class="govuk-link">@ActionLinkLabels.ReturnToDashBoard</a>
        </div>
    </div>
</div>
