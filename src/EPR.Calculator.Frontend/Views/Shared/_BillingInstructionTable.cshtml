@using System.Globalization
@using EPR.Calculator.Frontend.Enums
@using EPR.Calculator.Frontend.Extensions
@using EPR.Calculator.Frontend.Helpers
@model BillingInstructionsViewModel

<!-- Main Data Table -->
<table class="govuk-table billing-table govuk-!-margin-bottom-4" aria-describedby="table-description">
    <caption id="table-description" class="govuk-visually-hidden">
        Details of the Organisations and Billing status.
    </caption>
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header col-select"><span class="govuk-visually-hidden">Select</span></th>
            <th scope="col" class="govuk-table__header col-org-name">Organisation name</th>
            <th scope="col" class="govuk-table__header col-org-id">Organisation ID</th>
            <th scope="col" class="govuk-table__header col-billing">Billing instruction</th>
            <th scope="col" class="govuk-table__header col-invoice">Invoice amount</th>
            <th scope="col" class="govuk-table__header col-status">Status</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var org in Model.TablePaginationModel.Records.Cast<Organisation>())
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell vertical-middle billing-select-cell">
                    <div class="govuk-checkboxes govuk-checkboxes--small">
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input record-checkbox" type="checkbox"
                                   id="select-@org.Id"
                                   name="SelectedIds"
                                   value="@org.Id"
                                   data-organisation-id="@org.OrganisationId"
                                   data-organisation-name="@org.OrganisationName"
                                   @(org.IsSelected ? "checked" : null)
                                   @(org.BillingInstruction == BillingInstruction.Noaction ? "disabled" : null) />
                            <label class="govuk-label govuk-checkboxes__label" for="select-@org.Id">
                                <span class="govuk-visually-hidden">Select @org.OrganisationName</span>
                            </label>
                        </div>
                    </div>
                </td>

                <td class="govuk-table__cell vertical-middle">@org.OrganisationName</td>
                <td class="govuk-table__cell vertical-middle">@org.OrganisationId</td>
                <td class="govuk-table__cell vertical-middle">
                     @functions {
                            public string GetInstructionClass(EPR.Calculator.Frontend.Enums.BillingInstruction? instruction)
                            {
                                switch (instruction)
                                {
                                    case EPR.Calculator.Frontend.Enums.BillingInstruction.Noaction:
                                        return "govuk-tag--grey";
                                    case EPR.Calculator.Frontend.Enums.BillingInstruction.Rebill:
                                        return "govuk-tag--purple";
                                    case EPR.Calculator.Frontend.Enums.BillingInstruction.Delta:
                                        return "govuk-tag--green";
                                    case EPR.Calculator.Frontend.Enums.BillingInstruction.Cancel:
                                        return "govuk-tag--red";
                                    default:
                                        return ""; // Default blue
                                }
                            }
                        }
                    <strong class="govuk-tag @GetInstructionClass(org.BillingInstruction)">
                        @org.BillingInstruction?.GetDisplayName()
                    </strong>
                </td>
                <td class="govuk-table__cell vertical-middle">
                    @if (org.InvoiceAmount != null)
                    {
                        @org.InvoiceAmount.Value.ToString("C", CultureInfo.CreateSpecificCulture("en-GB"))
                    }
                </td>


                <td class="govuk-table__cell vertical-middle">
                    @if (org.BillingInstruction != BillingInstruction.Noaction)
                    {
                        @functions {
                            public string GetStatusClass(EPR.Calculator.Frontend.Enums.BillingStatus? status)
                            {
                                switch (status)
                                {
                                    case EPR.Calculator.Frontend.Enums.BillingStatus.Pending:
                                        return "govuk-tag--yellow grey";
                                    case EPR.Calculator.Frontend.Enums.BillingStatus.Accepted:
                                        return "govuk-tag--green";
                                    case EPR.Calculator.Frontend.Enums.BillingStatus.Rejected:
                                        return "govuk-tag--red";
                                    case EPR.Calculator.Frontend.Enums.BillingStatus.Noaction:
                                    default:
                                        return "govuk-tag--grey";
                                }
                            }
                        }

                        <strong class="govuk-tag @GetStatusClass(org.Status)">
                            @org.Status?.GetDisplayName()
                        </strong>
                    }
                    else
                    {
                        <span>&nbsp;</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>


@{
    // Calculate page block display
    int blockSize  = Model.TablePaginationModel.BlockSize;
    int blockStart = ((Model.TablePaginationModel.Page - 1) / blockSize) * blockSize + 1;
    int blockEnd   = Math.Min(blockStart + blockSize - 1, Model.TablePaginationModel.TotalPages);

    if (blockEnd == Model.TablePaginationModel.TotalPages)
    {
        blockStart = Math.Max(1, Model.TablePaginationModel.TotalPages - blockSize + 1);
    }

    RouteValueDictionary RouteValues(int page, int? pageSize = null)
    {
        var values = new RouteValueDictionary(Model.TablePaginationModel.RouteValues)
            {
                ["page"] = page
            };

        if (pageSize.HasValue)
        {
            values["pageSize"] = pageSize.Value;
        }

        return values;
    }
}

<div class="billing-pagination">
    <!-- Left side: GOV.UK pagination (previous, page numbers, next) -->
    <div class="billing-pagination__pages">
        <nav class="govuk-pagination" aria-label="Pagination">
            @if (Model.TablePaginationModel.Page > 1)
            {
                <div class="govuk-pagination__prev">
                    <a class="govuk-link govuk-pagination__link" href="@Url.RouteUrl(Model.TablePaginationModel.RouteName, RouteValues(page: Model.TablePaginationModel.Page - 1))" rel="prev">
                        <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                            <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                        </svg>
                        <span class="govuk-pagination__link-title">Previous<span class="govuk-visually-hidden"> page</span></span>
                    </a>
                </div>
            }

            <ul class="govuk-pagination__list">
                @if (blockStart > 1)
                {
                    <li class="govuk-pagination__item">
                        <a class="govuk-link govuk-pagination__link" href="@Url.RouteUrl(Model.TablePaginationModel.RouteName, RouteValues(page: 1))" aria-label="Page 1">1</a>
                    </li>
                    @if (blockStart > 2)  // show ellipsis only if gap > 1 page
                    {
                        <li class="govuk-pagination__item govuk-pagination__item--ellipsis">&ctdot;</li>
                    }
                }

                @for (int i = blockStart; i <= blockEnd; i++)
                {
                    if (Model.TablePaginationModel.Page == i)
                    {
                        <li class="govuk-pagination__item govuk-pagination__item--current">
                            <a class="govuk-link govuk-pagination__link" href="@Url.RouteUrl(Model.TablePaginationModel.RouteName, RouteValues(page: i))" aria-label="Page @i" aria-current="page">@i</a>
                        </li>
                    }
                    else
                    {
                        <li class="govuk-pagination__item">
                            <a class="govuk-link govuk-pagination__link" href="@Url.RouteUrl(Model.TablePaginationModel.RouteName, RouteValues(page: i))" aria-label="Page @i">@i</a>
                        </li>
                    }
                }

                @if (blockEnd < Model.TablePaginationModel.TotalPages)
                {
                    if (blockEnd < Model.TablePaginationModel.TotalPages - 1)
                    {
                        <li class="govuk-pagination__item govuk-pagination__item--ellipsis">&ctdot;</li>
                    }
                    <li class="govuk-pagination__item">
                        <a class="govuk-link govuk-pagination__link" href="@Url.RouteUrl(Model.TablePaginationModel.RouteName, RouteValues(page: Model.TablePaginationModel.TotalPages))" aria-label="Page @Model.TablePaginationModel.TotalPages">@Model.TablePaginationModel.TotalPages</a>
                    </li>
                }
            </ul>

            @if (Model.TablePaginationModel.Page < Model.TablePaginationModel.TotalPages)
            {
                <div class="govuk-pagination__next">
                    <a class="govuk-link govuk-pagination__link" href="@Url.RouteUrl(Model.TablePaginationModel.RouteName, RouteValues(page: Model.TablePaginationModel.Page + 1))" rel="next">
                        <span class="govuk-pagination__link-title">Next<span class="govuk-visually-hidden"> page</span></span>
                        <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                            <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path>
                        </svg>
                    </a>
                </div>
            }
        </nav>
    </div>

    <!-- Right side: items per page -->
    <div>
        <strong class="govuk-body">Items per page:</strong>
        <ul class="govuk-pagination__list pagination-page-size-list">
            @foreach (var size in Model.TablePaginationModel.PageSizeOptions)
            {
                if (Model.TablePaginationModel.PageSize == size)
                {
                    <li class="govuk-pagination__item pagination-page-size">
                        <strong>@size</strong>
                    </li>
                }
                else
                {
                    <li class="govuk-pagination__item pagination-page-size">
                        <a class="govuk-link govuk-pagination__link govuk-link--no-visited-state"
                           href="@Url.RouteUrl(Model.TablePaginationModel.RouteName, RouteValues(1, pageSize: size))"
                           aria-label="Show @size items per page">
                            @size
                        </a>
                    </li>
                }
            }
        </ul>
    </div>
</div>

@{
    var recordCount = Model.TablePaginationModel.Records.Count();
    var total       = Model.TotalRecords;
    var start       = total == 0 || recordCount == 0 ? 0 : Model.TablePaginationModel.StartRecord;
    var end         = total == 0 || recordCount == 0 ? 0 : Math.Min(start + recordCount - 1, total);
}
<p class="govuk-body govuk-!-margin-top-3">
    Showing @start.ToString("N0") to @end.ToString("N0") of @total.ToString("N0") organisations
</p>

<p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-top-6" id="selectedCountText" aria-live="polite">
    @ARJourneySessionHelper.GetSelectionSummary(Context.Session)
</p>

<script type="text/javascript" nonce="@Context.Items["CspNonce"]">
    document.addEventListener('click', function (event) {
        if (event.target.classList.contains('record-checkbox')) {
            var organisationId = event.target.getAttribute('data-organisation-id');
            var isChecked = event.target.checked;

            fetch('/UpdateOrganisationSelection', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    id: organisationId,
                    isSelected: isChecked,
                    organisationName: event.target.getAttribute('data-organisation-name')
                })
            }).then(function (response) {
                return response.ok ? response.json() : null;
            }).then(function (data) {
                if (data && data.summary) {
                    document.getElementById('selectedCountText').textContent = data.summary;
                }

                if (!isChecked) {
                    var selectPage = document.getElementById('OrganisationSelections_SelectPage');
                    var selectAll = document.getElementById('OrganisationSelections_SelectAll');
                    if (selectPage) selectPage.checked = false;
                    if (selectAll) selectAll.checked = false;
                }
            });
        }
    });
</script>
