@using EPR.Calculator.Frontend.Enums
@using EPR.Calculator.Frontend.Extensions
@using EPR.Calculator.Frontend.Helpers
@model SetRunClassificationViewModel

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/common.js"></script>

<vc:user-nav back-link="@Url.Action("Index", "CalculationRunDetailsNew", new { runId = Model.RunId })"/>

<main class="govuk-main-wrapper govuk-!-padding-top-4" id="main-content" role="main">

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @using (Html.BeginForm(ActionNames.Submit, ControllerNames.ClassifyingCalculationRun, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.RunId)

                <partial name="_ValidationSummaryPartial" />

                <div class="govuk-form-group">
                    <fieldset class="govuk-fieldset govuk-!-margin-bottom-8" aria-describedby="approval-code-hint">
                        <legend></legend>
                        <span id="approval-code-hint" class="govuk-caption-l">@Model.RunName</span>
                        <h1 class="govuk-heading-l">Classify calculation run</h1>

                        <table class="govuk-table" aria-describedby="table-description-calc">
                            <caption id="table-description-calc" class="govuk-visually-hidden">
                                Details of the calculation run including financial year, calculation ID, run date, and time.
                            </caption>
                            <tbody class="govuk-table__body">
                            <tr class="govuk-table__row">
                                <th scope="row" class="govuk-table__header">Financial year</th>
                                <td class="govuk-table__cell">@Model.RelativeYear.ToFinancialYear()</td>
                            </tr>
                            <tr class="govuk-table__row">
                                <th scope="row" class="govuk-table__header">Calculation ID</th>
                                <td class="govuk-table__cell">@Model.RunId</td>
                            </tr>
                            <tr class="govuk-table__row">
                                <th scope="row" class="govuk-table__header">Run date and time</th>
                                <td class="govuk-table__cell">@Model.CreatedAt.DisplayAsDateAtTime()</td>
                            </tr>
                            </tbody>
                        </table>
                        <hr class="govuk-section-break govuk-section-break--m govuk-section-break--invisible">

                        <div class="govuk-form-group @(ViewData.HasErrorFor(nameof(Model.ClassifyRunType)) ? "govuk-form-group--error" : "")">
                            <fieldset class="govuk-fieldset" aria-describedby="approval-code-hint" id=@nameof(Model.ClassifyRunType)>
                                <legend class="govuk-label govuk-fieldset__legend govuk-fieldset__legend--l"></legend>

                                @Html.ValidationMessageFor(model => model.ClassifyRunType, "", new { @class = "govuk-error-message" })

                                <div class="govuk-radios" data-module="govuk-radios">
                                    @if(Model.RelativeYearClassifications.Classifications.Any())
                                    {
                                        @foreach (var classification in Model.RelativeYearClassifications.Classifications.OrderBy(c => c.ToString()))
                                        {
                                            <div class="govuk-radios__item">
                                                @Html.RadioButtonFor(model => model.ClassifyRunType, (int) classification, new { @class = "govuk-radios__input", id = $"Radio_{classification}" })
                                                <label class="govuk-label govuk-radios__label" for="@($"Radio_{classification}")">
                                                    <strong>@classification.DisplayLabel</strong><br />
                                                    <p class="govuk-body-s govuk-!-margin-bottom-0">
                                                        @classification.Description
                                                    </p>
                                                </label>
                                            </div>
                                        }
                                    }
                                </div>
                            </fieldset>
                        </div>
                    </fieldset>

                    @if (Model.ImportantViewModel.Notification != ImportantSectionViewModel.NotificationType.None)
                    {
                        <div id="divNotification" class="govuk-notification-banner" role="region" aria-labelledby="govuk-notification-banner-title-classify-final" data-module="govuk-notification-banner">
                            <div id="divNotificationHeader" class="govuk-notification-banner__header">
                                <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title-classify-final">
                                    Important
                                </h2>
                            </div>

                            <div class="govuk-notification-banner__content">
                                @switch (Model.ImportantViewModel.Notification)
                                {
                                    case ImportantSectionViewModel.NotificationType.TestOnlyIncompleted:
                                        <p class="govuk-body-s">
                                            Run <b>@Model.ImportantViewModel.IncompleteOfficialRunId</b> is already classified,
                                            but its billing file has not yet been sent to the FSS.
                                        </p>
                                        <p class="govuk-body-s">
                                            Until that run is completed, you may only classify this as a test run.
                                        </p>
                                        <p class="govuk-body-s">
                                            If you want to make this an official run that can generate a billing file, you will
                                            need to either send the billing file for the run <b>@Model.ImportantViewModel.IncompleteOfficialRunId</b>
                                            to the FSS or remove the run's classification.
                                        </p>
                                        break;
                                    case ImportantSectionViewModel.NotificationType.TestOnlyOutdated:
                                        <p class="govuk-body-s">
                                            <b>Test run</b>
                                        </p>
                                        <p class="govuk-body-s">
                                            This run is out of date, the invoice position used for this run has been superseded
                                            through the classification of other runs as designated runs in this financial year.
                                            The classification as a Test run is the only option available.
                                        </p>
                                        break;
                                    case ImportantSectionViewModel.NotificationType.AlreadyCompleted:
                                        @if (Model.ImportantViewModel.InitialRunCompletedAt != null)
                                        {
                                            <p class="govuk-body-s">
                                                <strong>Initial run</strong><br/>
                                                Already completed for financial year @Model.ImportantViewModel.RelativeYear
                                                on @Model.ImportantViewModel.InitialRunCompletedAt.Value.ToString("dd MMM yyyy")
                                            </p>
                                        }

                                        @if (Model.ImportantViewModel.RecalculationCompletedAt != null)
                                        {
                                            <p class="govuk-body-s">
                                                <strong>Re-calculation run</strong><br/>
                                                Already completed for financial year @Model.ImportantViewModel.RelativeYear
                                                on @Model.ImportantViewModel.RecalculationCompletedAt.Value.ToString("dd MMM yyyy")
                                            </p>
                                        }

                                        break;
                                }
                            </div>
                        </div>
                    }

                    <div class="govuk-warning-text">
                        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                        <strong class="govuk-warning-text__text">
                            <span class="govuk-visually-hidden">Warning</span>
                            You cannot remove a run's classification after the billing file has been issued. Once classified, any previous unclassified runs can no longer be classified.
                        </strong>
                    </div>
                </div>
                <div class="govuk-button-group">
                    <button type="submit" class="govuk-button" data-module="govuk-button">
                        Confirm classification
                    </button>

                    <a href="@Url.Action(ActionNames.Index,ControllerNames.Dashboard)" class="govuk-link govuk-!-margin-left-4">@ActionLinkLabels.ReturnToDashBoard</a>
                </div>
            }
        </div>
    </div>
</main>
