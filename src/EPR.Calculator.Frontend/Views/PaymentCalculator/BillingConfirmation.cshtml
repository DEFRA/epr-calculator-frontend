@model BillingFileSuccessViewModel

<vc:user-nav show-back-link="false"/>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <div class="govuk-panel govuk-panel--confirmation">
            <h1 class="govuk-panel__title">Billing file shared</h1>
            <div class="govuk-panel__body">
                File reference<br><strong>@Model.RunId</strong>
            </div>
        </div>

        <h2 class="govuk-heading-m">What you need to do</h2>
        <p class="govuk-body">
            Tell the Financial Services Supplier that billing file @Model.RunId is ready to collect.
        </p>

        <h2 class="govuk-heading-m">What happens next</h2>
        <p class="govuk-body">
            The Financial Services Supplier will collect the file and process it using the billing instructions you accepted.
        </p>

        <p class="govuk-body">
            <a href="@Url.Action(ActionNames.Index, ControllerNames.Dashboard)" class="govuk-link">Return to dashboard</a>
        </p>
    </div>
</div>
