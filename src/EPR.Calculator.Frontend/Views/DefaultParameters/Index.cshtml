@using EPR.Calculator.Frontend.Extensions;
@model DefaultParametersViewModel

<div class="govuk-width-container">
    <main class="govuk-main-wrapper govuk-!-padding-top-4" id="main-content" role="main">

        <vc:user-nav back-link="@Url.Action("Index", "Dashboard")"/>

        @if(Model.IsDataAvailable)
        {
            <div class="govuk-caption-l govuk-!-margin-bottom-5">
                Last updated by @Model.LastUpdatedBy at @Model.LastUpdatedAt.DisplayAsTimeOnDate()
            </div>
        }
        <h1 class="govuk-heading-xl">Default calculator parameters</h1>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                @if(Model.IsDataAvailable)
                {
                    @foreach (ParameterType name in (ParameterType[])Enum.GetValues(typeof(ParameterType)))
                    {
                        var schemeparameterValue = @Model.SchemeParameters.First(t => t.SchemeParameterName == name.GetDisplayName());
                        if (name == ParameterType.BadDebtProvision && !schemeparameterValue.DefaultSchemeParameters.Any()) { continue; }

                        if(name == ParameterType.LateReportingTonnage)
                        {
                            <h2 class="govuk-heading-l">@name.GetDisplayName()</h2>
                            <table class="govuk-table govuk-!-margin-bottom-9">
                                <caption class="govuk-table__caption govuk-visually-hidden">
                                    Late reporting tonnage default parameters with RAG modulation
                                </caption>
                                <thead>
                                    <tr class="govuk-table__row">
                                        <th id="material_tonnage_header" class="govuk-table__header"></th>
                                        <th id="red_tonnage_header" class="govuk-table__header">Red</th>
                                        <th id="amber_tonnage_header" class="govuk-table__header">Amber</th>
                                        <th id="green_tonnage_header" class="govuk-table__header">Green</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in @Model.LateReportingTonnageParams)
                                    {
                                        <tr class="govuk-table__row">
                                            <th id="material_tonnage_header_row" class="govuk-table__header">@row.Material</th>
                                            <td class="govuk-table__cell">@row.Red.ToString("N3")</td>
                                            <td class="govuk-table__cell">@row.Amber.ToString("N3")</td>
                                            <td class="govuk-table__cell">@row.Green.ToString("N3")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <h2 class="govuk-heading-l">@name.GetDisplayName()</h2>
                            <partial name="_ItemListPartial" model="schemeparameterValue" />
                        }
                    }
                }
                else
                {
                    <span class="govuk-caption-xl">Default parameters have not been set.</span>
                    <br />
                    <hr />
                    <p class="govuk-body govuk-!-margin-top-6 govuk-!-margin-bottom-8">
                        You will need to upload a CSV file using the <a class="govuk-link" href="@Url.Action("DownloadCsvTemplate", "DefaultParametersUploadFile")">default parameters template</a> to set them before you can run any calculations.
                    </p>
                }

                @using (Html.BeginForm("DeleteCalculation", "CalculationRunDetails", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="answers-checked" value="true">
                    <div class="govuk-button-group">
                        <a href="@Url.Action("Index", "DefaultParametersUploadFile")" class="govuk-button" type="submit">Upload new default parameters</a>
                        <a href="@Url.Action("Index", "Dashboard")" class="govuk-link" href="dash">Return to the dashboard</a>
                    </div>
                }
            </div>
        </div>
    </main>
</div>
