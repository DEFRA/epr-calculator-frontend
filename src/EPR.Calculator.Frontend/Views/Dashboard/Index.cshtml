@model DashboardViewModel

@{
    ViewData["Title"] = "Index";
}

<vc:user-nav show-back-link="false" relative-year="@Model.RelativeYear"/>

<div class="govuk-grid-row dashboard-page">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-xl">Manage waste disposal fee calculations</h1>
        <h2 class="govuk-heading-l">Run a new calculation</h2>
        <div class="govuk-grid-row tile-group">
            <div class="govuk-grid-column-one-third">
                <div class="tile">
                    <h3 class="govuk-heading-m">Default parameters</h3>
                    <div class="tile__footer">
                        @if (Model.HasDefaultParameters)
                        {
                            <p class="govuk-body"><a href="/ViewDefaultParameters" class="govuk-link govuk-link--no-visited-state">View and update default parameters</a></p>
                        }
                        else
                        {
                            <p class="govuk-body">No default parameters are currently set for this financial year.</p>
                            <p class="govuk-body"><a href="@Url.Action("Index", "DefaultParametersUploadFile")" class="govuk-link govuk-link--no-visited-state">Set default parameters</a></p>
                        }
                    </div>
                </div>
            </div>
            <div class="govuk-grid-column-one-third">
                <div class="tile">
                    <h3 class="govuk-heading-m">Manage local authority disposal costs</h3>
                    <div class="tile__footer">
                        @if (Model.HasLocalAuthorityDisposalCosts)
                        {
                            <p class="govuk-body"><a href="/ViewLocalAuthorityDisposalCosts" class="govuk-link govuk-link--no-visited-state">View and update default disposal costs</a></p>
                        }
                        else
                        {
                            <p class="govuk-body">No local authority disposal costs have been set</p>
                            <p class="govuk-body"><a href="@Url.Action("Index", "LocalAuthorityUploadFile")" class="govuk-link govuk-link--no-visited-state">Set the disposal costs</a></p>
                        }
                    </div>
                </div>
            </div>
            <div class="govuk-grid-column-one-third">
                <div class="tile">
                    <h3 class="govuk-heading-m">Run a waste disposal fee calculation</h3>
                    <div class="tile__footer">
                        @if (Model.CanRunCalculation)
                        {
                            <p class="govuk-body"><a href="/RunANewCalculation" class="govuk-link govuk-link--no-visited-state">Run a calculation</a></p>
                        }
                        else
                        {
                            <p class="govuk-body">Set default parameters and local authority disposal costs before running a calculation.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Calculations.Count > 0)
        {
            <h2 class="govuk-heading-l">Calculation runs</h2>
            @await Html.PartialAsync("_CalculationRunsPartial", Model.Calculations)
        }
        else
        {
            <h2 class="govuk-heading-l">There are no calculations for @Model.RelativeYear.ToFinancialYear()</h2>
            <p class="govuk-body">When you run a waste disposal fee calculation, it will appear here.</p>
        }
    </div>
</div>
