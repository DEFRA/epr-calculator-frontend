@using EPR.Calculator.Frontend.Extensions
@model CalculationRunViewModel

<div class="govuk-summary-list__row">
    <dl>
        <dt class="govuk-summary-list__key">
            <h3 class="govuk-heading-m govuk-!-margin-bottom-3">
                @if (Model.HasLink)
                {
                    <a href="@Model.RunDetailLink" class="govuk-link govuk-link--no-visited-state">
                        @Model.Run.RunName
                    </a>
                }
                else
                {
                    @Model.Run.RunName
                }
            </h3>

            <p class="govuk-body">
                Calculation ID: @Model.Run.RunId<br />
                Date: @Model.Run.CreatedAt.DisplayAsDateAtTime()<br />
                Run by: @Model.Run.CreatedBy
            </p>
        </dt>
    </dl>

    @if (Model.HasTag)
    {
        <dd class="govuk-summary-list__actions govuk-!-text-align-centre">
            <strong class="@Model.TagStyle">
                @Model.Run.ClassificationStatusLabel
            </strong>
        </dd>
    }
</div>
