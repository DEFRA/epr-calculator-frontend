@model ShareBillingFileViewModel

@{
    var hasError = ViewData.ModelState[nameof(ShareBillingFileFormModel.ConfirmShare)]?.Errors.Any() == true;
    var formGroupClass = "govuk-form-group" + (hasError ? " govuk-form-group--error" : "");
}

<vc:user-nav back-link="@Url.Action("Index", "DesignatedRunWithBillingFile", new { runId = Model.RunId })"/>

@if (!Model.IsBillingFileLatest)
{
    <partial name="_BillingInstructionsPartial"
             model="@Url.Action(ActionNames.Index, ControllerNames.CalculationRunOverview, new { runId = Model.RunId })"/>
}

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-three-quarters">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert"
                     aria-labelledby="error-summary-title" tabindex="-1">
                    <h2 class="govuk-error-summary__title" id="error-summary-title">
                        There is a problem
                    </h2>
                    <div class="govuk-error-summary__body">
                        <ul class="govuk-list govuk-error-summary__list">
                            @if (hasError)
                            {
                                <li>
                                    <a href="#Confirm">@ViewData.ModelState[nameof(ShareBillingFileFormModel.ConfirmShare)]?.Errors.First().ErrorMessage</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            @using (Html.BeginForm(ActionNames.Submit, ControllerNames.SendBillingFile, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.RunId)

                <h1 class="govuk-heading-l">Share billing file</h1>
                <hr class="govuk-section-break govuk-section-break--s govuk-section-break--invisible">

                <p class="govuk-body">
                    You are about to share this billing file with the Financial Services Supplier (FSS).
                </p>

                <table class="govuk-table">
                    <caption class="govuk-visually-hidden">
                        Details of the calculation run.
                    </caption>
                    <tbody class="govuk-table__body">
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">Run name</th>
                        <td class="govuk-table__cell" colspan="2">@Model.Run.RunName</td>
                    </tr>
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">Financial year</th>
                        <td class="govuk-table__cell" colspan="2">@Model.Run.RelativeYear.ToFinancialYear()</td>
                    </tr>
                    <tr class="govuk-table__row">
                        <th scope="row" class="govuk-table__header">Billing file</th>
                        <td class="govuk-table__cell">@Model.Run.BillingFile?.CsvFileName</td>
                        <td class="govuk-table__cell">
                            <a class="govuk-link govuk-link--no-visited-state"
                               href="@Url.Action(ActionNames.DownloadBillingFile, ControllerNames.FileDownloadController, new { Model.RunId })">
                                Download billing file
                            </a>
                        </td>
                    </tr>
                    </tbody>
                </table>
                <div class="govuk-warning-text">
                    <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                    <strong class="govuk-warning-text__text">
                        <span class="govuk-visually-hidden">Warning</span>
                        You cannot change the billing decisions for this run in PayCal after you share the file.
                    </strong>
                </div>

                <div class="@formGroupClass">
                    <fieldset class="govuk-fieldset" aria-describedby="@(hasError ? "Confirm-error" : null)">
                        @if (hasError)
                        {
                            <p id="Confirm-error" class="govuk-error-message">
                                <span class="govuk-visually-hidden">Error:</span>
                                @ViewData.ModelState[nameof(ShareBillingFileFormModel.ConfirmShare)]?.Errors.First().ErrorMessage
                            </p>
                        }

                        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                            <div class="govuk-checkboxes__item">
                                <input type="checkbox" class="govuk-checkboxes__input" id="Confirm"
                                       name="Confirm" value="true" @(Model.ConfirmShare == true ? "checked" : "")/>
                                <label class="govuk-label govuk-checkboxes__label" for="Confirm">
                                    I have checked this billing file and am ready to share it.
                                </label>
                            </div>
                        </div>
                    </fieldset>
                </div>

                <div class="govuk-button-group">
                    <button type="submit" @(Model.IsBillingFileLatest ? "" : "disabled") class="govuk-button"
                            data-module="govuk-button">
                        Share billing file
                    </button>
                </div>
            }
        </div>
    </div>
</div>
