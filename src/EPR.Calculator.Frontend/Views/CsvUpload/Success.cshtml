@model EPR.Calculator.Frontend.ViewModels.CsvUpload.CsvUploadSuccessViewModel;

@{
    ViewData["Title"] = Model.Title;
}

<vc:user-nav show-back-link="false"/>

<div class="govuk-width-container">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <div class="govuk-panel govuk-panel--confirmation govuk-!-margin-bottom-6">
                <h1 class="govuk-panel__title">
                    @Model.Title
                </h1>
            </div>

            <h2 class="govuk-heading-m">What happens next</h2>

            <p class="govuk-body">
                You need both calculator parameters and local authority disposal costs
                for @Model.RelativeYear.ToFinancialYear() before you can create a new calculation run.
            </p>

            <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

            <div class="govuk-button-group">
                <a href="@Model.ViewLinkUrl" class="govuk-button govuk-!-margin-right-4" type="submit">
                    @Model.ViewLinkText
                </a>

                <a href="@Url.Action(ActionNames.Index, ControllerNames.Dashboard)" class="govuk-link govuk-link--no-visited-state">
                    Return to dashboard
                </a>
            </div>
        </div>
    </div>
</div>
